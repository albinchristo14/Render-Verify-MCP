# Export settings or configure the MCP client; this file is not auto-loaded.
TRANSPORT=stdio
ALLOW_LOCAL=false
MAX_SESSIONS=5
SESSION_TTL_MS=600000
NAVIGATION_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=5000
MAX_OUTPUT_BYTES=65536
MAX_SCREENSHOT_BYTES=5242880
# Local development requires both of these:
# ALLOW_LOCAL=true
# ALLOWED_DOMAINS=127.0.0.1,localhost
# Optional installed-browser override (validated in this cloud instance):
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
